# 管理后台密码（登录后台用）
ADMIN_PASSWORD=your-admin-password

# Session 加密密钥（随机长字符串，至少 32 字符）
SESSION_SECRET=your-random-secret-at-least-32-chars-long

# 本地开发 API 地址
NEXT_PUBLIC_API_URL=http://localhost:3000
# ====== Cloudflare Pages 部署时在 Dashboard 绑定（非 .env 变量）======
# NAV_KV     — KV 命名空间（必需，存导航数据 + 默认图片存储）
# R2_BUCKET  — R2 存储桶（可选，配了图片走 R2，不配图片走 KV）